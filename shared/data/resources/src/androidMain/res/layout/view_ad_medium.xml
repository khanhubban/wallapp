<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ad_height_medium"
    android:orientation="vertical"
    android:paddingLeft="@dimen/margin_normal"
    android:paddingRight="@dimen/margin_normal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingTop="4dp">

        <ImageView
            android:id="@id/ad_app_icon"
            style="@style/AdIcon"
            tools:src="@color/accent"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_small">

            <TextView
                style="@style/AdTitle"
                android:id="@id/ad_headline"
                tools:text="Test Ad: QuickBooks Self-Employed: Tax Tracker &amp; Invoicing"/>

            <RatingBar
                android:id="@id/ad_stars"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:isIndicator="true"
                android:numStars="5"
                android:stepSize="0.5" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@id/ad_body"
        style="@style/AdBody"
        tools:text="Voted #1 free Dating App. Meet local singles nearby. Never pay to send a msg."/>

    <Button
        style="@style/AdActionButton.FullWidth"
        android:id="@id/ad_call_to_action"
        tools:text="Install"/>

</LinearLayout>
