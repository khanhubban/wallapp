<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ad_height_short"
    android:orientation="horizontal"
    android:paddingStart="22dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@id/ad_app_icon"
        style="@style/AdIcon"
        android:layout_gravity="center_vertical"
        tools:src="@color/accent"/>

    <LinearLayout
        android:layout_height="wrap_content"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:paddingStart="@dimen/margin_small"
        android:paddingEnd="4dp"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@id/ad_headline"
            style="@style/AdTitle.Short"
            tools:text="Test Ad: QuickBooks Self-Employed: Tax Tracker &amp; Invoicing"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@id/ad_body"
            style="@style/AdBody.Short"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:textSize="13sp"
            tools:text="Invoice Simple is a fast and easy invoice app for sending invoices and estimates to your customers."/>

    </LinearLayout>

    <Button
        android:id="@id/ad_call_to_action"
        style="@style/AdActionButton.Short"
        android:layout_gravity="center_vertical"
        tools:text="Install"/>

</LinearLayout>
