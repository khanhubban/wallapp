<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ad_height_short_rounded"
    android:background="@android:color/white"
    tools:targetApi="lollipop">

    <FrameLayout
        android:id="@+id/permission_setting_content"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_margin="@dimen/margin_small"
        android:background="@drawable/bg_settings_item_dialog_prompt"
        android:elevation="4dp">

        <ImageView
            android:id="@id/ad_app_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"/>

        <!-- margin start = icon left margin + icon width + icon right margin -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="16dp"
            android:layout_marginLeft="68dp"
            android:layout_marginRight="16dp"
            android:layout_marginStart="68dp"
            android:orientation="vertical">

            <TextView
                android:id="@id/ad_headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/settings_title"
                android:textSize="16sp"/>

            <Space
                android:layout_width="wrap_content"
                android:layout_height="2dp"/>

            <TextView
                android:id="@id/ad_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/SettingsItemButtonText"/>

        </LinearLayout>
    </FrameLayout>

</FrameLayout>